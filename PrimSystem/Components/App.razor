@inject IWebHostEnvironment Env
<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="only light" />
    <meta name="darkreader-lock" />
    <base href="/" />
    @* app.css adresine dosya sürümü eklenir: aksi halde tarayıcı eski CSS'i önbellekten kullanıp yeni arayüzü eski/bozuk gösterebiliyor. *@
    <link rel="stylesheet" href="app.css?v=@AssetVersion("app.css")" />
    <link rel="stylesheet" href="PrimSystem.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <title>Prim Yönetim Sistemi</title>
    <HeadOutlet />
</head>

<body>
    @* Açılış ekranı: Blazor bağlanana kadar (prerender kapalı olduğu için sayfa boş kalırdı) animasyonlu logo.
       Uygulama içeriği DOM'a gelince aşağıdaki betik bunu kaldırır. Zemin şeffaf: sayfanın kendi arka planı (krem + yeşil dekor) görünür, geçişte renk sıçraması olmaz. *@
    <div id="boot-splash" role="status" aria-label="Yükleniyor" style="position:fixed;inset:0;z-index:2000;display:flex;flex-direction:column;align-items:center;justify-content:center;font-family:Segoe UI,sans-serif">
        <picture>
            <source media="(prefers-reduced-motion: reduce)" srcset="/images/prim-symbol.png" />
            <img src="/images/waiting.png" alt="" width="96" height="77" style="display:block;object-fit:contain" />
        </picture>
        <p style="margin:10px 0 0;color:#3e5b58;font-size:14px;font-weight:600">Yükleniyor…</p>
    </div>
    <Routes @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
    <script>
        (function () {
            var splash = document.getElementById('boot-splash');
            if (!splash) return;
            function ready() {
                return !!document.body.querySelector(':scope > :not(#boot-splash):not(script):not(#blazor-error-ui):not(link):not(style)');
            }
            function hide() { if (splash.parentNode) splash.parentNode.removeChild(splash); }
            if (ready()) { hide(); return; }
            var mo = new MutationObserver(function () { if (ready()) { mo.disconnect(); hide(); } });
            mo.observe(document.body, { childList: true });
            setTimeout(hide, 30000); // bağlantı hiç kurulamazsa ekran sonsuza dek kalmasın
        })();
    </script>
    <script src="_framework/blazor.web.js"></script>
    @* Chart.js 4.4.0 — YEREL. Daha önce cdn.jsdelivr.net'ten yükleniyordu; dışarı kapalı
       kurumsal ağda tüm grafikler SESSİZCE boş kalıyordu (çağıran kod `if (typeof Chart ===
       'undefined') return;` ile hata bile vermiyor). Dosya CDN'deki sürümle bit bazında
       özdeş — SHA-384 doğrulandı:
         sha384-e6nUZLBkQ86NJ6TVVKAeSaK8jWa3NhkYWZFomE39AvDbQWeie9PlQqM3pmYW5d1g
       Sürüm yükseltilirken bu hash yeniden hesaplanıp buraya yazılmalı. Aynı origin'den
       geldiği için integrity/crossorigin özniteliklerine gerek yok.
       Artık sayfa açılışında yüklenmez: fileUpload.js ilk grafik çizilirken lib/chart.umd.min.js'i yükler. *@

    <script src="fileUpload.js?v=@AssetVersion("fileUpload.js")"></script>
</body>

</html>

@code {
    // wwwroot dosyasının son yazılma zamanı: dosya değişince adres değişir, tarayıcı yenisini çeker.
    private string AssetVersion(string file)
    {
        try { return File.GetLastWriteTimeUtc(Path.Combine(Env.WebRootPath, file)).Ticks.ToString("x"); }
        catch { return "0"; }
    }
}
