@inherits LayoutComponentBase
@using PrimSystem.Components.Shared
@using PrimSystem.Services
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject SessionState Session
@inject ProtectedSessionStorage SessionStorage

@* Oturum restore denenene kadar hiçbir sayfa render olmaz — yenilemede
   LoginRequired flash'ını ve üst menü tuşlarının kaybolmasını önler. *@
@if (!Session.RestoreAttempted)
{
    <GlobalLoading />
    return;
}

<ImpersonationBanner />
@if (Session.IsAdmin)
{
    <PublishPanel />
}
<AppTopBar />

<ErrorBoundary @ref="errorBoundary">
    <ChildContent>
        @Body
    </ChildContent>
    <ErrorContent>
        <div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:#0a0f1a;font-family:Segoe UI,sans-serif">
            <div style="text-align:center;max-width:400px">
                <div style="font-size:48px;margin-bottom:12px">⚠</div>
                <h2 style="color:#ef4444;margin:0 0 8px;font-size:18px">Bir hata oluştu</h2>
                <p style="color:#94a3b8;font-size:13px;margin-bottom:16px">Sayfa yüklenirken beklenmeyen bir sorun oluştu.</p>
                <button onclick="location.reload()" style="padding:10px 24px;background:#3b82f6;color:#fff;border:none;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer">Sayfayı Yenile</button>
            </div>
        </div>
    </ErrorContent>
</ErrorBoundary>

@code {
    private ErrorBoundary? errorBoundary;
    private bool _sessionChecked;

    protected override void OnParametersSet()
    {
        errorBoundary?.Recover();
    }

    // Oturum geri yükleme merkezi olarak burada (layout her zaman render olur);
    // sayfa düzeyindeki Session guard'ları restore tamamlanınca doğru duruma kavuşur.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_sessionChecked)
        {
            _sessionChecked = true;
            await Session.RestoreSessionAsync(SessionStorage);
            StateHasChanged();
        }
    }
}