@page "/change-password"
@using PrimSystem.Services
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject AuthService Auth
@inject SessionState Session
@inject NavigationManager Nav
@inject ProtectedSessionStorage SessionStorage
@rendermode InteractiveServer

<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:#0a0f1a;font-family:Segoe UI,sans-serif">
    <div style="width:420px;background:#111827;border:1px solid #1e293b;border-radius:16px;padding:36px">

        <div style="text-align:center;margin-bottom:28px">
            <div style="width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,#f59e0b,#ef4444);display:inline-flex;align-items:center;justify-content:center;font-size:22px;margin-bottom:12px">🔑</div>
            <h2 style="color:#f1f5f9;margin:0;font-size:18px">Şifre Değiştir</h2>
            @if (isMandatory)
            {
                <p style="color:#f59e0b;margin:6px 0 0;font-size:12px;font-weight:600">İlk girişinizde şifrenizi değiştirmeniz gerekmektedir.</p>
            }
            else
            {
                <p style="color:#64748b;margin:4px 0 0;font-size:13px">@Session.CurrentUser?.FullName</p>
            }
        </div>

        @if (!string.IsNullOrEmpty(errorMsg))
        {
            <div style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);border-radius:8px;padding:10px 14px;margin-bottom:14px;color:#ef4444;font-size:13px">@errorMsg</div>
        }

        @if (success)
        {
            <div style="background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.3);border-radius:8px;padding:14px;text-align:center;color:#10b981;font-size:14px;font-weight:600">
                ✓ Şifreniz başarıyla değiştirildi. Yönlendiriliyorsunuz...
            </div>
        }
        else
        {
            <div style="margin-bottom:14px">
                <label style="display:block;font-size:12px;color:#94a3b8;margin-bottom:5px;font-weight:500">Mevcut Şifre</label>
                <input type="password" @bind="currentPassword"
                       style="width:100%;padding:10px 13px;background:#0a0f1a;border:1px solid #1e293b;border-radius:8px;color:#f1f5f9;font-size:13px;outline:none;box-sizing:border-box" />
            </div>

            <div style="margin-bottom:14px">
                <label style="display:block;font-size:12px;color:#94a3b8;margin-bottom:5px;font-weight:500">Yeni Şifre</label>
                <input type="password" @bind="newPassword"
                       style="width:100%;padding:10px 13px;background:#0a0f1a;border:1px solid #1e293b;border-radius:8px;color:#f1f5f9;font-size:13px;outline:none;box-sizing:border-box" />
            </div>

            <div style="margin-bottom:24px">
                <label style="display:block;font-size:12px;color:#94a3b8;margin-bottom:5px;font-weight:500">Yeni Şifre (Tekrar)</label>
                <input type="password" @bind="confirmPassword" @onkeypress="HandleKey"
                       style="width:100%;padding:10px 13px;background:#0a0f1a;border:1px solid #1e293b;border-radius:8px;color:#f1f5f9;font-size:13px;outline:none;box-sizing:border-box" />
            </div>

            <div style="display:flex;gap:8px">
                @if (!isMandatory)
                {
                    <button @onclick='() => Nav.NavigateTo("/")'
                            style="flex:1;padding:11px;background:rgba(148,163,184,0.1);color:#94a3b8;border:1px solid #1e293b;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer">
                        İptal
                    </button>
                }
                <button @onclick="DoChange" disabled="@isLoading"
                        style="flex:2;padding:11px;background:#3b82f6;color:#fff;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer">
                    @(isLoading ? "Değiştiriliyor..." : "Şifreyi Değiştir")
                </button>
            </div>
        }
    </div>
</div>

@code {
    private string currentPassword = "";
    private string newPassword = "";
    private string confirmPassword = "";
    private string errorMsg = "";
    private bool isLoading = false;
    private bool success = false;
    private bool isMandatory = false;

    private bool _sessionChecked = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_sessionChecked)
        {
            _sessionChecked = true;
            await Session.RestoreSessionAsync(SessionStorage);
            if (Session.IsLoggedIn)
                isMandatory = Session.CurrentUser?.MustChangePassword ?? false;
            StateHasChanged();
        }
    }

    private async Task HandleKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await DoChange();
    }

    private async Task DoChange()
    {
        errorMsg = "";
        if (string.IsNullOrWhiteSpace(currentPassword)) { errorMsg = "Mevcut şifreyi giriniz"; return; }
        if (string.IsNullOrWhiteSpace(newPassword)) { errorMsg = "Yeni şifreyi giriniz"; return; }
        if (newPassword.Length < 8 || !newPassword.Any(char.IsLetter) || !newPassword.Any(char.IsDigit))
        { errorMsg = "Yeni şifre en az 8 karakter olmalı ve harf ile rakam içermeli"; return; }
        if (newPassword != confirmPassword) { errorMsg = "Yeni şifreler eşleşmiyor"; return; }
        if (!Session.IsLoggedIn) { Nav.NavigateTo("/login"); return; }

        isLoading = true;
        try
        {
            var ok = await Auth.ChangePasswordAsync(Session.CurrentUser!.UserId, currentPassword, newPassword);
            if (!ok) { errorMsg = "Mevcut şifre hatalı"; return; }

            success = true;
            StateHasChanged();
            await Task.Delay(1800);
            Nav.NavigateTo("/");
        }
        catch (Exception ex)
        {
            errorMsg = "Hata: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
