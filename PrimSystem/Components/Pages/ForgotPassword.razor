@page "/forgot-password"
@using PrimSystem.Services
@inject AuthService Auth
@inject EmailService EmailSvc
@inject NavigationManager Nav
@inject IConfiguration Config
@rendermode InteractiveServer

<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:#0a0f1a;font-family:Segoe UI,sans-serif">
    <div style="width:420px;background:#111827;border:1px solid #1e293b;border-radius:16px;padding:40px">

        <div style="text-align:center;margin-bottom:28px">
            <div style="width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,#3b82f6,#6366f1);display:inline-flex;align-items:center;justify-content:center;font-size:22px;margin-bottom:12px">📧</div>
            <h2 style="color:#f1f5f9;margin:0;font-size:18px">Şifremi Unuttum</h2>
            <p style="color:#64748b;margin:4px 0 0;font-size:13px">E-posta adresinize sıfırlama linki gönderilecek</p>
        </div>

        @if (!string.IsNullOrEmpty(infoMsg))
        {
            <div style="background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.3);border-radius:8px;padding:14px;text-align:center;color:#10b981;font-size:13px;margin-bottom:16px">
                @infoMsg
            </div>
        }

        @if (!string.IsNullOrEmpty(errorMsg))
        {
            <div style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);border-radius:8px;padding:10px 14px;margin-bottom:14px;color:#ef4444;font-size:13px">
                @errorMsg
            </div>
        }

        @if (!sent)
        {
            <div style="margin-bottom:20px">
                <label style="display:block;font-size:12px;color:#94a3b8;margin-bottom:6px;font-weight:500">E-posta Adresi</label>
                <input type="email" @bind="email" @bind:event="oninput" @onkeypress="HandleKey"
                       placeholder="ornek@sirket.com"
                       style="width:100%;padding:10px 14px;background:#0a0f1a;border:1px solid #1e293b;border-radius:8px;color:#f1f5f9;font-size:14px;outline:none;box-sizing:border-box" />
            </div>

            <button @onclick="DoSend" disabled="@isLoading"
                    style="width:100%;padding:12px;background:#3b82f6;color:#fff;border:none;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer;margin-bottom:12px">
                @(isLoading ? "Gönderiliyor..." : "Sıfırlama Linki Gönder")
            </button>
        }

        <div style="text-align:center">
            <a href="/login" style="font-size:12px;color:#64748b;text-decoration:none">← Giriş sayfasına dön</a>
        </div>
    </div>
</div>

@code {
    private string email = "";
    private string infoMsg = "";
    private string errorMsg = "";
    private bool isLoading = false;
    private bool sent = false;

    private async Task HandleKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await DoSend();
    }

    private async Task DoSend()
    {
        errorMsg = "";
        if (string.IsNullOrWhiteSpace(email)) { errorMsg = "E-posta adresi giriniz"; return; }

        isLoading = true;
        try
        {
            var token = await Auth.ForgotPasswordAsync(email.Trim().ToLower());

            if (token != null)
            {
                // Host header spoofing'e karşı yapılandırılmış adres tercih edilir;
                // AppBaseUrl boş/placeholder ise istek adresine düşülür.
                var configured = Config["AppBaseUrl"];
                var baseUrl = (!string.IsNullOrWhiteSpace(configured) && configured.StartsWith("http"))
                    ? configured.TrimEnd('/')
                    : Nav.BaseUri.TrimEnd('/');
                var resetUrl = $"{baseUrl}/reset-password?token={token}";
                var html = $@"
                    <div style='font-family:Segoe UI,sans-serif;max-width:480px;margin:0 auto'>
                        <h2 style='color:#1e293b'>Şifre Sıfırlama</h2>
                        <p style='color:#475569'>Merhaba,</p>
                        <p style='color:#475569'>Prim Yönetim Sistemi için şifre sıfırlama talebiniz alındı.</p>
                        <div style='margin:24px 0'>
                            <a href='{resetUrl}'
                               style='padding:12px 24px;background:#3b82f6;color:#fff;border-radius:8px;text-decoration:none;font-weight:600;display:inline-block'>
                                Şifremi Sıfırla
                            </a>
                        </div>
                        <p style='color:#94a3b8;font-size:12px'>Bu link 1 saat geçerlidir. Talepte bulunmadıysanız bu e-postayı görmezden gelebilirsiniz.</p>
                    </div>";

                await EmailSvc.SendAsync(email.Trim(), "Prim Sistemi — Şifre Sıfırlama", html);
            }

            // Güvenlik: kullanıcı var/yok bilgisi verme
            sent = true;
            infoMsg = "E-posta adresiniz sistemde kayıtlıysa sıfırlama linki gönderildi. Gelen kutunuzu kontrol edin.";
        }
        catch (Exception ex)
        {
            errorMsg = "Gönderim hatası: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
