                    </div>
                }
                <div style="color:#94a3b8;margin-top:6px">Eşlersen kaynak adı bu karşılığa "hatırlanır"; sonraki yüklemelerde otomatik eşleşir.</div>
                @if (aliasMsg != null) { <div style="color:@(aliasMsg.StartsWith("Hata") ? "#fca5a5" : "#10b981");margin-top:4px">@aliasMsg</div> }
            </div>
        }

        @* ── Ürün-Marka alias atama önizlemesi ─────────────────────── *@
        @if (previewResult.ProductMapPreview.Any())
        {
            <div style="background:rgba(59,130,246,0.05);border:1px solid rgba(59,130,246,0.2);border-radius:7px;padding:8px 12px;margin-bottom:10px;font-size:11px;max-height:160px;overflow-y:auto">
                <div style="color:#94a3b8;font-weight:600;margin-bottom:4px">Atanacak alias'lar (Kanonik Ürün ← Marka):</div>
                @foreach (var line in previewResult.ProductMapPreview.Take(40)) { <div style="color:#cbd5e1">• @line</div> }
                @if (previewResult.ProductMapPreview.Count > 40) { <div style="color:#64748b">… +@(previewResult.ProductMapPreview.Count - 40) ürün daha</div> }
            </div>
        }

        @if (previewResult.Errors.Any())
        {
            <div style="background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.25);border-radius:7px;padding:8px 12px;margin-bottom:10px;color:#f59e0b;font-size:11px;max-height:100px;overflow-y:auto">
                @foreach (var e in previewResult.Errors.Take(10)) { <div>⚠ @e</div> }
                @if (previewResult.Errors.Count > 10) { <div style="color:#94a3b8">… +@(previewResult.Errors.Count - 10) uyarı daha (yükleme sonrası geçmişten görülebilir)</div> }
            </div>
        }
        <div style="display:flex;gap:8px">
            <button @onclick="ConfirmPending" disabled="@(loading != "")"
                    style="padding:8px 18px;background:linear-gradient(135deg,#10b981,#059669);color:#fff;border:none;border-radius:8px;font-size:13px;font-weight:700;cursor:pointer">
                ✅ Onayla ve Yükle
            </button>
            <button @onclick="CancelPending" disabled="@(loading != "")"
                    style="padding:8px 18px;background:rgba(100,116,139,0.15);color:#94a3b8;border:1px solid rgba(100,116,139,0.3);border-radius:8px;font-size:13px;cursor:pointer">
                ✖ İptal
            </button>
        </div>
    </div>;

    // ── Sonuç bloğu (başarı + teyit + uyarılar + hata) ───────────────────────
    private RenderFragment? ResultBlock(ImportResult? r)
    {
        if (r == null) return null;
        return @<div>
            @if (r.Success && !r.IsDryRun)
            {
                <div style="margin-top:8px;color:#10b981;font-size:12px">✓ @r.InsertedRows yeni · @r.UpdatedRows güncellendi · @r.SkippedRows atlandı · @r.ProcessingMs ms</div>
                @if (r.DetailRowCount > 0)
                {
                    <div style="margin-top:4px;color:#94a3b8;font-size:12px">📦 @r.DetailRowCount.ToString("N0") GLN/kurum detay satırı kaydedildi</div>
                }
                @if (r.Verified == true)
                {
                    <div style="margin-top:4px;color:#10b981;font-size:12px">
                        ✅ Teyit: @r.VerifiedCount/@r.ExpectedCount satır DB'de@(r.FileTotal.HasValue ? $" · toplam {r.DbTotal:N0} birebir eşleşti" : "")
                    </div>
                }
                else if (r.Verified == false)
                {
                    <div style="margin-top:4px;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.35);border-radius:7px;padding:8px 12px;color:#ef4444;font-size:12px">
                        ⚠ TEYİT BAŞARISIZ — beklenen @r.ExpectedCount satır, DB'de @r.VerifiedCount bulundu@(r.FileTotal.HasValue ? $" (dosya toplamı {r.FileTotal:N0}, DB toplamı {r.DbTotal:N0})" : "").
                        Yükleme Geçmişi'nden bu içe aktarmayı geri alıp tekrar deneyin.
                    </div>
                }
                @if (r.DetailConsistent == false)
                {
                    <div style="margin-top:4px;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.35);border-radius:7px;padding:8px 12px;color:#ef4444;font-size:12px">
                        ⚠ GLN detay toplamı brick toplamıyla uyuşmuyor — veriyi geri alıp tekrar yükleyin.
                    </div>
                }
                @if (r.BrickAssignmentsSynced > 0 || r.BrickAssignmentsDeactivated > 0)
                {
                    <div style="margin-top:4px;color:#93c5fd;font-size:12px">🗺 Brick→ST: @r.BrickAssignmentsSynced atama yazıldı@(r.BrickAssignmentsDeactivated > 0 ? $", {r.BrickAssignmentsDeactivated} eski/çakışan pasiflendi" : "")</div>
                }
                @if (r.UnassignedTargetRows > 0)
                {
                    <div style="margin-top:4px;color:#f59e0b;font-size:12px">⚠ @r.UnassignedTargetRows.ToString("N0") atanmamış satır (toplam @r.UnassignedTargetQty.ToString("N0") hedef) hiçbir ST'ye düşmedi</div>
                }
                @if (r.BlankGlnRows > 0)
                {
                    <div style="margin-top:4px;color:#f59e0b;font-size:12px">⚠ @r.BlankGlnRows.ToString("N0") satırın GLN'i boştu — işaretlenmedi</div>
                }
            }
            @if (r.Errors.Any())
            {
                <div style="margin-top:8px;background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.25);border-radius:7px;padding:8px 12px;color:#f59e0b;font-size:11px;max-height:100px;overflow-y:auto">
                    @foreach (var e in r.Errors.Take(8)) { <div>⚠ @e</div> }
                </div>
            }
            @if (!string.IsNullOrEmpty(r.Error))
            {
                <div style="margin-top:8px;color:#ef4444;font-size:12px">❌ @r.Error</div>
            }
        </div>;
    }

    private bool rollbackBusy;

    private async Task Rollback(int logId)
    {
        if (rollbackBusy) return;                 // çift-tık koruması (yavaş silmede yarış → çökme)
        rollbackBusy = true; confirmRollbackId = null; StateHasChanged();
        try { msg = await ImportSvc.RollbackImportAsync(logId, Session.RequireUserId()); }
        catch (UnauthorizedAccessException) { Nav.NavigateTo("/login"); return; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Rollback hatası (log {LogId})", logId);
            msg = "Geri alma başarısız: " + ex.Message;
        }
        finally { rollbackBusy = false; }
        await LoadLogs(); StateHasChanged();
        await Task.Delay(3000); msg = ""; StateHasChanged();
    }

    private async Task DeleteLog(int logId)
    {
        if (rollbackBusy) return;
        rollbackBusy = true; StateHasChanged();
        try { msg = await ImportSvc.DeleteLogAsync(logId, Session.RequireUserId()); }
        catch (UnauthorizedAccessException) { Nav.NavigateTo("/login"); return; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "DeleteLog hatası (log {LogId})", logId);
            msg = "Silme başarısız: " + ex.Message;
        }
        finally { rollbackBusy = false; }
        await LoadLogs(); StateHasChanged();
        await Task.Delay(2000); msg = ""; StateHasChanged();
    }

    private async Task DownloadTemplate(string type)
    {
        var bytes = ExportSvc.GetImportTemplate(type);
        await JS.InvokeVoidAsync("downloadBytes", $"sablon_{type}.xlsx", bytes);
    }
