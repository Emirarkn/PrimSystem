        {
            <div style="background:rgba(245,158,11,0.12);border:1px solid rgba(245,158,11,0.35);border-radius:7px;padding:8px 12px;margin-bottom:8px;color:#f59e0b;font-size:12px">
                ⚠ Bu dosya (aynı içerikle) <strong>@previewResult.DuplicateOf.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</strong> tarihinde zaten yüklenmiş.
            </div>
        }
        <div style="display:flex;gap:16px;flex-wrap:wrap;font-size:12px;margin-bottom:8px">
            <span style="color:#94a3b8">@previewResult.TotalRows satır okundu</span>
            <span style="color:#10b981">@previewResult.InsertedRows @(pendingType == "productmap" ? "ürün alias alacak" : "yeni eklenecek")</span>
            @if (pendingType != "productmap")
            {
                <span style="color:#3b82f6">@previewResult.UpdatedRows güncellenecek</span>
            }
            <span style="color:@(previewResult.SkippedRows > 0 ? "#f59e0b" : "#64748b")">@previewResult.SkippedRows atlanacak</span>
            @if (previewResult.FileTotal.HasValue)
            {
                <span style="color:#94a3b8">toplam: @previewResult.FileTotal.Value.ToString("N0")</span>
            }
            @if (previewResult.DetailRowCount > 0)
            {
                <span style="color:#94a3b8">@previewResult.DetailRowCount.ToString("N0") GLN detay</span>
            }
        </div>

        @* ── Eşleşme kapsamı (double-check) ─────────────────────────── *@
        @if (previewResult.TotalBrandCount > 0 || previewResult.TotalBrickCount > 0 || previewResult.TotalPeriodCount > 0)
        {
            <div style="display:flex;gap:14px;flex-wrap:wrap;font-size:12px;margin-bottom:8px;padding:8px 12px;background:rgba(16,185,129,0.05);border:1px solid rgba(16,185,129,0.2);border-radius:7px">
                <span style="color:#94a3b8;font-weight:600">Eşleşme:</span>
                @if (previewResult.TotalBrandCount > 0)
                {
                    <span style="color:@(previewResult.UnmatchedBrands.Any() ? "#f59e0b" : "#10b981")">Marka @previewResult.MatchedBrandCount/@previewResult.TotalBrandCount</span>
                }
                @if (previewResult.TotalBrickCount > 0)
                {
                    <span style="color:@(previewResult.MatchedBrickCount < previewResult.TotalBrickCount ? "#f59e0b" : "#10b981")">Brick @previewResult.MatchedBrickCount/@previewResult.TotalBrickCount</span>
                }
                @if (previewResult.TotalPeriodCount > 0)
                {
                    <span style="color:@(previewResult.MatchedPeriodCount < previewResult.TotalPeriodCount ? "#f59e0b" : "#10b981")">Dönem @previewResult.MatchedPeriodCount/@previewResult.TotalPeriodCount</span>
                }
            </div>
        }

        @* ── Hedef: atanmamış satır özeti (— / BRICK ATANMAMIŞ) ───────── *@
        @if (previewResult.UnassignedTargetRows > 0)
        {
            <div style="background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.25);border-radius:7px;padding:8px 12px;margin-bottom:10px;color:#f59e0b;font-size:12px">
                ⚠ <strong>@previewResult.UnassignedTargetRows.ToString("N0") satır atanmamış</strong> (Mümessil '—' / Brick '(BRICK ATANMAMIŞ)') —
                toplam <strong>@previewResult.UnassignedTargetQty.ToString("N0")</strong> hedef hiçbir ST'ye düşmez (skora dahil edilmez).
            </div>
        }

        @* ── Eczane planı: GLN'i boş satırlar ─────────────────────────── *@
        @if (previewResult.BlankGlnRows > 0)
        {
            <div style="background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.25);border-radius:7px;padding:8px 12px;margin-bottom:10px;color:#f59e0b;font-size:12px">
                ⚠ <strong>@previewResult.BlankGlnRows.ToString("N0") satırın GLN'i boş</strong> — eşleşemediği için işaretlenmeyecek.
                Kaynak raporda düzeltilmesi gereken bir veri kalitesi sorunu.
            </div>
        }

        @* ── Brick→ST haritası senkronu (Hedef/Brick importu) ─────────── *@
        @if (previewResult.BrickAssignmentsSynced > 0 || previewResult.BrickAssignmentsDeactivated > 0)
        {
            <div style="background:rgba(59,130,246,0.06);border:1px solid rgba(59,130,246,0.25);border-radius:7px;padding:8px 12px;margin-bottom:10px;color:#93c5fd;font-size:12px">
                🗺 Brick→ST haritası: <strong>@previewResult.BrickAssignmentsSynced</strong> atama yazılacak/güncellenecek@(previewResult.BrickAssignmentsDeactivated > 0 ? $", {previewResult.BrickAssignmentsDeactivated} eski/çakışan atama pasiflenecek" : "").
                Hedef ve gerçekleşen bu haritadan hesaplanır.
            </div>
        }

        @* ── KAPI: eşleşmeyen marka → satış skora yansımaz ──────────── *@
        @if (previewResult.UnmatchedBrands.Any())
        {
            <div style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.4);border-radius:7px;padding:8px 12px;margin-bottom:10px;color:#ef4444;font-size:12px">
                ⛔ <strong>Eşleşmeyen marka(lar)</strong> — bu satırlar atlanır, satış skora <strong>YANSIMAZ</strong>:
                <div style="color:#fca5a5;margin-top:4px">@string.Join(", ", previewResult.UnmatchedBrands.Take(20))@(previewResult.UnmatchedBrands.Count > 20 ? $" (+{previewResult.UnmatchedBrands.Count - 20})" : "")</div>
                <div style="color:#94a3b8;margin-top:4px">Çözüm: <strong>"Ürün-Marka Eşleştirme"</strong> dosyasını yükleyip alias ekleyin, sonra tekrar deneyin.</div>
            </div>
        }

        @* ── Bulanık eşleşme önerileri ("bunu mu demek istediniz") + tek-tık eşle ── *@
        @if (previewResult.MatchSuggestions.Any())
        {
            <div style="background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.35);border-radius:7px;padding:8px 12px;margin-bottom:10px;font-size:12px">
                <div style="color:#f59e0b;font-weight:600;margin-bottom:6px">🔎 Eşleşmeyen değerler için olası karşılıklar (tek tıkla eşle &amp; hatırla):</div>
                @foreach (var s in previewResult.MatchSuggestions.Take(20))
                {
                    <div style="display:flex;align-items:center;gap:8px;margin-top:3px">
                        <span style="color:#fcd34d;flex:1">@TypeLabel(s.Type): <strong>@s.Source</strong> → @s.Suggestion</span>
                        <button class="btn-secondary" style="padding:2px 10px;font-size:11px" disabled="@savingAlias"
