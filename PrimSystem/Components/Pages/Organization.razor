                    <button @onclick="() => bulkResetResults = null" style="padding:8px 18px;background:rgba(98,119,116,0.1);color:var(--text-dim);border:1px solid var(--border);border-radius:8px;font-size:12px;font-weight:600;cursor:pointer">Kapat</button>
