@page "/organization"
@using PrimSystem.Services
@using PrimSystem.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject IDbContextFactory<AppDbContext> DbFactory
@inject SessionState Session
@inject NavigationManager Nav
@inject ProtectedSessionStorage SessionStorage
@inject AuthService AuthSvc
@inject AdminGuard Guard
@inject AuditService Audit
@inject Microsoft.JSInterop.IJSRuntime JS
@rendermode InteractiveServer

@if (!Session.IsLoggedIn)
{
    <LoginRequired />
    return;
}
@if (!Session.CanViewAll)
{
    <NotAuthorizedView />
    return;
}

<div style="min-height:100vh;background:var(--bg-base);font-family:Segoe UI,sans-serif">

    <div style="max-width:1200px;margin:0 auto;padding:20px">

        <!-- Sayfa Basligi + Kontroller -->
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-bottom:16px">
            <div>
                <h1 class="p-title" style="font-size:28px;text-transform:none"><Icon Name="users" Size="28" />Organizasyon Yönetimi</h1>
                <div style="font-size:14px;color:var(--text-dim);margin-top:2px">@regions.Count Bölge · @bmCount BM · @stCount ST</div>
            </div>
            <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                <label class="sr-only" for="orgSearch" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">Kullanıcı ara</label>
                <input id="orgSearch" @bind="searchTerm" @bind:event="oninput" placeholder="Kullanıcı, bölge veya temsilci ara…"
                       style="padding:9px 14px;background:var(--bg-card);border:1px solid var(--border-strong);border-radius:12px;color:var(--text);font-size:13px;width:280px;outline:none" />
                <button @onclick="ToggleInactive"
                        style="padding:9px 16px;background:@(showInactive ? "rgba(181,65,58,0.12)" : "var(--bg-card)");color:@(showInactive ? "var(--danger)" : "var(--brand-deep)");border:1px solid @(showInactive ? "rgba(181,65,58,0.3)" : "var(--border-strong)");border-radius:12px;font-size:13px;font-weight:700;cursor:pointer">
                    @(showInactive ? "Pasif Gizle" : "Pasif Kullanıcılar")
                </button>
                @if (Session.CanManage)
                {
                    <button type="button" class="p-btn" @onclick="ShowAddUser"><Icon Name="plus" Size="15" />Kullanıcı Ekle</button>
                    <button type="button" @onclick="() => showBulkResetConfirm = true" style="display:inline-flex;align-items:center;gap:7px;padding:9px 16px;background:#fff5f3;color:var(--danger-text);border:1px solid #efc2bb;border-radius:12px;font-size:13px;font-weight:700;cursor:pointer"><Icon Name="key" Size="15" />Tüm Şifreleri Sıfırla</button>
                }
            </div>
        </div>

        @if (!string.IsNullOrEmpty(message))
        {
            <div style="background:rgba(10,107,102,0.1);border:1px solid rgba(10,107,102,0.3);border-radius:8px;padding:10px 14px;margin-bottom:12px;color:var(--accent);font-size:13px">@message</div>
        }

        <!-- AKTİF OTURUMLAR PANELİ (sadece admin) -->
        @if (Session.CanManage && activeSessions.Any())
        {
            <div style="background:var(--bg-card);border:1px solid rgba(10,107,102,0.3);border-radius:12px;margin-bottom:16px;overflow:hidden">
                <div @onclick="() => showOnlinePanel = !showOnlinePanel"
                     style="padding:13px 20px;background:linear-gradient(90deg,#055955,#0a6b66);border-bottom:1px solid rgba(10,107,102,0.2);display:flex;align-items:center;justify-content:space-between;cursor:pointer;user-select:none">
                    <div style="display:flex;align-items:center;gap:10px">
                        <span aria-hidden="true" style="width:11px;height:11px;border-radius:50%;background:#46d6a4;box-shadow:0 0 0 3px rgba(70,214,164,.3)"></span>
                        <span style="font-size:15px;font-weight:800;color:#fff">Aktif Oturumlar</span>
                        <span style="padding:2px 8px;border-radius:999px;font-size:10px;font-weight:700;background:rgba(18,65,62,0.18);color:#fff;border:1px solid rgba(18,65,62,0.35)">@activeSessions.Count kişi online</span>
                    </div>
                    <span style="color:#d6f1ea;font-size:12px;font-weight:600">@(showOnlinePanel ? "▲ Gizle" : "▼ Göster")</span>
                </div>
                @if (showOnlinePanel)
                {
                    <table style="width:100%;border-collapse:collapse;font-size:12px">
                        <thead>
                            <tr>
                                @foreach (var h in new[] { "KULLANICI", "BÖLGE", "GİRİŞ SAATİ", "BU OTURUM", "TOPLAM ONLINE" })
                                {
                                    <th style="padding:8px 14px;text-align:left;color:var(--text-faint);font-size:10px;font-weight:700;border-bottom:1px solid var(--border)">@h</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in activeSessions)
                            {
                                <tr style="border-bottom:1px solid #1e293b22">
                                    <td style="padding:8px 14px;color:var(--text);font-weight:600">🟢 @s.FullName</td>
                                    <td style="padding:8px 14px;color:var(--text-dim)">@s.Region</td>
                                    <td style="padding:8px 14px;color:var(--text-dim);font-family:monospace">@s.LoginAt.ToLocalTime().ToString("HH:mm")</td>
                                    <td style="padding:8px 14px;color:var(--accent);font-weight:600">
                                        @if (s.CurrentMinutes < 60)
                                        {
                                            <span>@s.CurrentMinutes dk</span>
                                        }
                                        else
                                        {
                                            <span>@(s.CurrentMinutes / 60)s @(s.CurrentMinutes % 60)dk</span>
                                        }
                                    </td>
                                    <td style="padding:8px 14px;color:var(--text-faint)">
                                        @if (s.TotalMinutes < 60)
                                        {
                                            <span>@s.TotalMinutes dk</span>
                                        }
                                        else
                                        {
                                            <span>@(s.TotalMinutes / 60)s @(s.TotalMinutes % 60)dk</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }

        <!-- AKTİF KULLANICILAR — Bölge Bazlı -->
        @foreach (var region in regions)
        {
            var regionUsers = users.Where(u => u.RegionId == region.RegionId).ToList();
            var regionBMs = regionUsers.Where(u => u.RoleId == RoleId.BM).ToList();
            var regionSTs = regionUsers.Where(u => u.RoleId == RoleId.ST).ToList();
            var regionYon = regionUsers.Where(u => u.RoleId == RoleId.Yonetici).ToList();

            // Arama filtresi
            var visibleSTs = regionSTs.Where(UserMatches).ToList();
            var visibleBMs = regionBMs.Where(bm => UserMatches(bm) || regionSTs.Any(st => st.ManagerId == bm.UserId && UserMatches(st))).ToList();
            var visibleYon = regionYon.Where(UserMatches).ToList();
            if (!string.IsNullOrEmpty(searchTerm) && !visibleSTs.Any() && !visibleBMs.Any() && !visibleYon.Any()) continue;

            <div @key="region.RegionId" style="background:var(--bg-card);border:1px solid var(--border);border-radius:12px;margin-bottom:12px;overflow:hidden">
                <div style="padding:12px 18px;background:var(--bg-elevated);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between">
                    <div style="display:flex;align-items:center;gap:10px">
                        <span style="font-size:15px;font-weight:700;color:var(--text)">@region.Name</span>
                        <span style="padding:2px 9px;border-radius:999px;font-size:10px;font-weight:700;background:rgba(42,106,158,0.12);color:var(--info);border:1px solid rgba(42,106,158,0.3)">@regionSTs.Count ST</span>
                    </div>
                </div>

                @foreach (var yon in visibleYon)
                {
                    <div style="padding:6px 18px;display:flex;align-items:center;gap:8px">
                        <span style="width:8px;height:8px;border-radius:50%;background:var(--violet);display:inline-block"></span>
                        <span style="font-size:11px;color:var(--violet);font-weight:600">Yönetici: @yon.FullName</span>
                        <span style="font-size:10px;color:var(--text-faint)">@yon.Email</span>
                    </div>
                }

                @foreach (var bm in visibleBMs)
                {
                    var bmSTs = regionSTs.Where(s => s.ManagerId == bm.UserId && UserMatches(s)).ToList();
                    <div style="padding:8px 18px">
                        <div style="font-size:11px;color:var(--warning);font-weight:600;margin-bottom:6px;display:flex;align-items:center;gap:6px">
                            <span style="width:8px;height:8px;border-radius:50%;background:var(--warning);display:inline-block"></span>
                            BM: @bm.FullName
                            <span style="font-size:10px;color:var(--info-text);font-weight:600;font-family:monospace">@bm.Username</span>
                            @if (bm.MustChangePassword)
                            {
                                <span style="padding:1px 6px;border-radius:4px;font-size:9px;font-weight:700;background:rgba(181,65,58,0.12);color:var(--danger);border:1px solid rgba(181,65,58,0.25)">Şifre Değiştirilmeli</span>
                            }
                            @if (Session.CanManage)
                            {
                                <button @onclick="() => StartEditUser(bm)" title="Düzenle" aria-label="Düzenle" style="background:none;border:none;cursor:pointer;color:var(--text-faint);font-size:11px;padding:0;margin-left:4px"><Icon Name="edit" Size="15" /></button>
                                <button @onclick="() => QuickReset(bm)" aria-label="Şifreyi sıfırla" style="background:none;border:none;cursor:pointer;color:var(--warning);font-size:11px;padding:0;margin-left:2px" title="Şifreyi sıfırla"><Icon Name="key" Size="15" /></button>
                                <button @onclick="() => Impersonate(bm)" aria-label="Bu kullanıcı olarak görüntüle" style="background:none;border:none;cursor:pointer;color:var(--info);font-size:11px;padding:0;margin-left:2px" title="Bu kullanıcı olarak giriş yap"><Icon Name="user" Size="15" /></button>
                                @if (confirmDeleteUserId == bm.UserId)
                                {
                                    <span style="font-size:10px;color:var(--danger)">Emin misiniz?</span>
                                    <button @onclick="() => ConfirmDeactivate(bm)" style="padding:1px 7px;background:rgba(181,65,58,0.15);color:var(--danger);border:1px solid rgba(181,65,58,0.3);border-radius:4px;font-size:10px;cursor:pointer">Evet</button>
                                    <button @onclick="CancelDelete" style="padding:1px 7px;background:rgba(98,119,116,0.1);color:var(--text-dim);border:1px solid var(--border);border-radius:4px;font-size:10px;cursor:pointer">Hayır</button>
                                }
                                else
                                {
                                    <button @onclick="() => confirmDeleteUserId = bm.UserId" title="Pasifleştir" aria-label="Pasifleştir" style="background:none;border:none;cursor:pointer;color:var(--text-faint);font-size:11px;padding:0"><Icon Name="trash" Size="15" /></button>
                                }
                            }
                        </div>
                        <div style="display:flex;flex-wrap:wrap;gap:6px;margin-left:14px">
                            @foreach (var st in bmSTs)
                            {
                                var brickCount = userBricks.Count(ub => ub.UserId == st.UserId && ub.IsActive);
                                var monthsWorked = ((DateTime.Now.Year - st.HireDate.Year) * 12) + DateTime.Now.Month - st.HireDate.Month;
                                var isNew = monthsWorked < st.MinMonths;
                                <div style="display:flex;align-items:flex-start;gap:8px;padding:7px 12px;background:var(--bg-base);border-radius:8px;border:1px solid var(--border);font-size:12px">
                                    <div>
                                        <div style="display:flex;align-items:center;gap:5px;margin-bottom:2px">
                                            <span style="font-weight:600;color:var(--text)">@st.FullName</span>
                                            @if (Session.CanManage)
                                            {
                                                var status = OnlineStatus(st.UserId);
                                                @if (!string.IsNullOrEmpty(status))
                                                {
                                                    <span style="font-size:10px;cursor:pointer" title="Oturum geçmişi" @onclick="() => ShowSessionHistory(st.UserId)">@status</span>
                                                }
                                            }
                                            @if (isNew)
                                            {
                                                <span style="padding:1px 6px;border-radius:4px;font-size:9px;font-weight:700;background:rgba(217,148,40,0.15);color:var(--warning)">YENİ</span>
                                            }
                                            @if (st.MustChangePassword)
                                            {
                                                <span style="padding:1px 6px;border-radius:4px;font-size:9px;font-weight:700;background:rgba(181,65,58,0.12);color:var(--danger);border:1px solid rgba(181,65,58,0.25)">Şifre Değiştirilmeli</span>
                                            }
                                        </div>
                                        <div style="font-size:10px;color:var(--text-faint)">
                                            <span style="color:var(--info-text);font-weight:600;font-family:monospace">@st.Username</span> · @brickCount brick · Giriş: @st.HireDate.ToString("dd.MM.yyyy")
                                            @if (st.BirthDate.HasValue)
                                            {
                                                <span> · DG: @st.BirthDate.Value.ToString("dd.MM")</span>
                                            }
                                            · Min @st.MinMonths ay
                                        </div>
                                    </div>
                                    @if (Session.CanManage)
                                    {
                                        <div style="display:flex;align-items:center;gap:4px;margin-left:auto">
                                            <button @onclick="() => StartEditUser(st)" title="Düzenle" aria-label="Düzenle" style="background:none;border:none;cursor:pointer;color:var(--text-faint);font-size:12px;padding:2px"><Icon Name="edit" Size="15" /></button>
                                            <button @onclick="() => QuickReset(st)" aria-label="Şifreyi sıfırla" style="background:none;border:none;cursor:pointer;color:var(--warning);font-size:12px;padding:2px" title="Şifreyi sıfırla"><Icon Name="key" Size="15" /></button>
                                            <button @onclick="() => Impersonate(st)" aria-label="Bu kullanıcı olarak görüntüle" style="background:none;border:none;cursor:pointer;color:var(--info);font-size:12px;padding:2px" title="Bu kullanıcı olarak giriş yap"><Icon Name="user" Size="15" /></button>
                                            @if (confirmDeleteUserId == st.UserId)
                                            {
                                                <span style="font-size:10px;color:var(--danger);white-space:nowrap">Emin mi?</span>
                                                <button @onclick="() => ConfirmDeactivate(st)" style="padding:2px 7px;background:rgba(181,65,58,0.15);color:var(--danger);border:1px solid rgba(181,65,58,0.3);border-radius:4px;font-size:10px;cursor:pointer">Evet</button>
                                                <button @onclick="CancelDelete" style="padding:2px 7px;background:rgba(98,119,116,0.1);color:var(--text-dim);border:1px solid var(--border);border-radius:4px;font-size:10px;cursor:pointer">Hayır</button>
                                            }
                                            else
                                            {
                                                <button @onclick="() => confirmDeleteUserId = st.UserId" title="Pasifleştir" aria-label="Pasifleştir" style="background:none;border:none;cursor:pointer;color:var(--text-faint);font-size:12px;padding:2px"><Icon Name="trash" Size="15" /></button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (!visibleBMs.Any() && !visibleSTs.Any() && !visibleYon.Any() && string.IsNullOrEmpty(searchTerm))
                {
                    <div style="padding:12px 18px;color:var(--text-faint);font-size:12px;font-style:italic">Bu bölgede henüz kullanıcı atanmamış</div>
                }
            </div>
        }

        <!-- Bölgesi olmayan kullanıcılar -->
        @{
            var noRegion = users.Where(u => u.RegionId == null && u.RoleId > 1 && UserMatches(u)).ToList();
        }
        @if (noRegion.Any())
        {
            <div style="background:var(--bg-card);border:1px solid rgba(181,65,58,0.3);border-radius:12px;padding:16px;margin-bottom:12px">
                <div style="font-size:13px;font-weight:700;color:var(--danger);margin-bottom:8px">Bölge Atanmamış (@noRegion.Count)</div>
                <div style="display:flex;flex-wrap:wrap;gap:6px">
                    @foreach (var u in noRegion)
                    {
                        <div style="display:flex;align-items:center;gap:6px;padding:5px 10px;background:var(--bg-base);border:1px solid var(--border);border-radius:6px;font-size:12px">
                            <span style="color:var(--text)">@u.FullName</span>
                            <span style="color:var(--text-faint)">(@u.Role?.Name)</span>
                            @if (Session.CanManage)
                            {
                                <button @onclick="() => StartEditUser(u)" title="Düzenle" aria-label="Düzenle" style="background:none;border:none;cursor:pointer;color:var(--text-faint);font-size:11px;padding:0"><Icon Name="edit" Size="15" /></button>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        <!-- PASİF KULLANICILAR -->
        @if (showInactive && inactiveUsers.Any())
        {
            <div style="background:var(--bg-card);border:1px solid rgba(181,65,58,0.2);border-radius:12px;padding:16px">
                <div style="font-size:13px;font-weight:700;color:var(--danger);margin-bottom:10px">Pasif / Deaktif Kullanıcılar (@inactiveUsers.Count)</div>
                <div style="display:flex;flex-direction:column;gap:6px">
                    @foreach (var u in inactiveUsers.Where(UserMatches))
                    {
                        <div style="display:flex;align-items:center;justify-content:space-between;padding:8px 14px;background:var(--bg-base);border:1px solid var(--border);border-radius:8px;font-size:12px;opacity:0.7">
                            <div>
                                <span style="font-weight:600;color:var(--text)">@u.FullName</span>
                                <span style="color:var(--text-faint);margin-left:8px">@(u.Email ?? "—") · @u.Role?.Name</span>
                                @if (u.DeactivatedAt.HasValue)
                                {
                                    <span style="color:var(--text-faint);margin-left:8px">· Deaktif: @u.DeactivatedAt.Value.ToLocalTime().ToString("dd.MM.yyyy")</span>
                                }
                            </div>
                            @if (Session.CanManage)
                            {
                                <button @onclick="() => ReactivateUser(u)"
                                        style="padding:4px 12px;background:rgba(10,107,102,0.12);color:var(--accent);border:1px solid rgba(10,107,102,0.3);border-radius:6px;font-size:11px;font-weight:600;cursor:pointer">
                                    Aktif Et
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        @if (showInactive && !inactiveUsers.Any())
        {
            <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:16px;text-align:center;color:var(--text-faint);font-size:13px">Pasif kullanıcı yok</div>
        }
    </div>

    <!-- TOPLU SIFIRLAMA ONAY MODALI -->
    @if (showBulkResetConfirm)
    {
        <div style="position:fixed;inset:0;z-index:999;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.6);backdrop-filter:blur(3px)" @onclick="CloseBulkConfirm">
            <div style="background:var(--bg-card);border:1px solid rgba(217,148,40,0.4);border-radius:14px;padding:28px;width:420px" @onclick:stopPropagation>
                <div style="font-size:18px;margin-bottom:10px">⚠️</div>
                <h3 style="margin:0 0 10px;font-size:16px;color:var(--text)">Tüm Şifreleri Sıfırla</h3>
                <p style="margin:0 0 14px;font-size:13px;color:var(--text-dim)">
                    Sizin dışınızdaki tüm aktif kullanıcılara <strong style="color:var(--warning)">rastgele geçici şifre</strong> atanacak ve ilk girişte şifre değiştirmeleri zorunlu olacak.<br/><br/>
                    Yeni şifreler <strong style="color:var(--text)">yalnızca bir kez</strong> gösterilir (liste + CSV). Pencereyi kapattıktan sonra tekrar görülemez; bunun için tek tek sıfırlamanız gerekir.
                </p>
                <label for="bulkConfirm" style="display:block;font-size:11px;color:var(--text-dim);margin-bottom:4px">Onaylamak için <strong style="color:var(--warning);font-family:monospace">SIFIRLA</strong> yazın</label>
                <input id="bulkConfirm" @bind="bulkConfirmText" @bind:event="oninput" autocomplete="off" style="width:100%;box-sizing:border-box;margin-bottom:18px;padding:8px 10px;background:var(--bg-base);color:var(--text);border:1px solid var(--border);border-radius:8px;font-size:13px" />
                <div style="display:flex;gap:8px;justify-content:flex-end">
                    <button @onclick="CloseBulkConfirm" style="padding:8px 18px;background:rgba(98,119,116,0.1);color:var(--text-dim);border:1px solid var(--border);border-radius:8px;font-size:12px;font-weight:600;cursor:pointer">İptal</button>
                    <button @onclick="DoBulkReset" disabled="@(isBulkResetting || bulkConfirmText.Trim() != "SIFIRLA")" style="padding:8px 18px;background:rgba(217,148,40,0.15);color:var(--warning);border:1px solid rgba(217,148,40,0.4);border-radius:8px;font-size:12px;font-weight:700;cursor:pointer">
                        @(isBulkResetting ? "Sıfırlanıyor..." : "Evet, Sıfırla")
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- TOPLU SIFIRLAMA SONUCU: parolalar yalnızca burada, bir kez -->
    @if (bulkResetResults != null)
    {
        <div style="position:fixed;inset:0;z-index:999;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.6);backdrop-filter:blur(3px)">
            <div role="dialog" aria-labelledby="bulkResultTitle" style="background:var(--bg-card);border:1px solid rgba(10,107,102,0.4);border-radius:14px;padding:24px;width:560px;max-width:92vw;max-height:86vh;display:flex;flex-direction:column">
                <h3 id="bulkResultTitle" style="margin:0 0 6px;font-size:16px;color:var(--text)">@bulkResetResults.Count kullanıcının şifresi sıfırlandı</h3>
                <p style="margin:0 0 12px;font-size:12px;color:var(--warning)">Bu liste yalnızca şimdi görünür. CSV'yi indirin ve kullanıcılara güvenli yoldan iletin; dosyayı iş bitince silin.</p>
                <div style="overflow:auto;border:1px solid var(--border);border-radius:8px;margin-bottom:14px">
                    <table style="width:100%;border-collapse:collapse;font-size:12px;color:var(--text-soft)">
                        <thead><tr style="text-align:left;color:var(--text-dim);position:sticky;top:0;background:var(--bg-card)"><th scope="col" style="padding:7px 10px">Ad Soyad</th><th scope="col" style="padding:7px 10px">Kullanıcı Adı</th><th scope="col" style="padding:7px 10px">Geçici Şifre</th></tr></thead>
                        <tbody>
                            @foreach (var c in bulkResetResults)
                            {
                                <tr style="border-top:1px solid var(--border)"><td style="padding:6px 10px">@c.FullName</td><td style="padding:6px 10px;font-family:monospace">@c.Username</td><td style="padding:6px 10px;font-family:monospace;color:var(--accent)">@c.TemporaryPassword</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
