@page "/reset-password"
@using PrimSystem.Services
@inject AuthService Auth
@inject NavigationManager Nav
@rendermode InteractiveServer

<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:#0a0f1a;font-family:Segoe UI,sans-serif">
    <div style="width:420px;background:#111827;border:1px solid #1e293b;border-radius:16px;padding:40px">

        <div style="text-align:center;margin-bottom:28px">
            <div style="width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,#10b981,#3b82f6);display:inline-flex;align-items:center;justify-content:center;font-size:22px;margin-bottom:12px">🔐</div>
            <h2 style="color:#f1f5f9;margin:0;font-size:18px">Yeni Şifre Belirle</h2>
        </div>

        @if (tokenInvalid)
        {
            <div style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);border-radius:8px;padding:16px;text-align:center;color:#ef4444;font-size:13px;margin-bottom:20px">
                ❌ Bu link geçersiz veya süresi dolmuş.<br/>
                <a href="/forgot-password" style="color:#ef4444;margin-top:8px;display:inline-block">Yeni link talep et →</a>
            </div>
        }
        else if (success)
        {
            <div style="background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.3);border-radius:8px;padding:14px;text-align:center;color:#10b981;font-size:14px;font-weight:600">
                ✓ Şifreniz başarıyla değiştirildi. Yönlendiriliyorsunuz...
            </div>
        }
        else if (!string.IsNullOrEmpty(Token))
        {
            @if (!string.IsNullOrEmpty(errorMsg))
            {
                <div style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);border-radius:8px;padding:10px 14px;margin-bottom:14px;color:#ef4444;font-size:13px">@errorMsg</div>
            }

            <div style="margin-bottom:14px">
                <label style="display:block;font-size:12px;color:#94a3b8;margin-bottom:5px;font-weight:500">Yeni Şifre</label>
                <input type="password" @bind="newPassword"
                       style="width:100%;padding:10px 13px;background:#0a0f1a;border:1px solid #1e293b;border-radius:8px;color:#f1f5f9;font-size:13px;outline:none;box-sizing:border-box" />
            </div>

            <div style="margin-bottom:24px">
                <label style="display:block;font-size:12px;color:#94a3b8;margin-bottom:5px;font-weight:500">Yeni Şifre (Tekrar)</label>
                <input type="password" @bind="confirmPassword" @onkeypress="HandleKey"
                       style="width:100%;padding:10px 13px;background:#0a0f1a;border:1px solid #1e293b;border-radius:8px;color:#f1f5f9;font-size:13px;outline:none;box-sizing:border-box" />
            </div>

            <button @onclick="DoReset" disabled="@isLoading"
                    style="width:100%;padding:12px;background:#3b82f6;color:#fff;border:none;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer">
                @(isLoading ? "Kaydediliyor..." : "Şifreyi Kaydet")
            </button>
        }

        <div style="text-align:center;margin-top:16px">
            <a href="/login" style="font-size:12px;color:#64748b;text-decoration:none">← Giriş sayfasına dön</a>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Token { get; set; }

    private string newPassword = "";
    private string confirmPassword = "";
    private string errorMsg = "";
    private bool isLoading = false;
    private bool success = false;
    private bool tokenInvalid = false;

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(Token))
            tokenInvalid = true;
    }

    private async Task HandleKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await DoReset();
    }

    private async Task DoReset()
    {
        errorMsg = "";
        if (string.IsNullOrWhiteSpace(newPassword)) { errorMsg = "Yeni şifre giriniz"; return; }
        if (newPassword.Length < 8 || !newPassword.Any(char.IsLetter) || !newPassword.Any(char.IsDigit))
        { errorMsg = "Şifre en az 8 karakter olmalı ve harf ile rakam içermeli"; return; }
        if (newPassword != confirmPassword) { errorMsg = "Şifreler eşleşmiyor"; return; }

        isLoading = true;
        try
        {
            var ok = await Auth.ResetPasswordAsync(Token!, newPassword);
            if (!ok)
            {
                tokenInvalid = true;
                return;
            }
            success = true;
            StateHasChanged();
            await Task.Delay(1800);
            Nav.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            errorMsg = "Hata: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
