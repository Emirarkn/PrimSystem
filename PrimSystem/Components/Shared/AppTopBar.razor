@using PrimSystem.Services
@using PrimSystem.Components.Shared
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@implements IDisposable
@inject SessionState Session
@inject NavigationManager Nav
@inject ProtectedSessionStorage SessionStorage

@if (Session.IsLoggedIn)
{
    <div style="position:sticky;top:0;z-index:100;height:56px;background:rgba(255,253,249,0.88);border-bottom:1px solid var(--border);box-shadow:0 4px 18px rgba(5,89,85,0.06);backdrop-filter:blur(14px);padding:0 24px;display:flex;align-items:center;justify-content:space-between;font-family:Segoe UI,sans-serif">

        <!-- Sol: Logo + Nav -->
        <div style="display:flex;align-items:center;gap:16px;height:100%">
            <div style="display:flex;align-items:center;gap:10px;cursor:pointer" @onclick='() => Nav.NavigateTo("/")'>
                <img src="/images/prim-symbol.png" alt="" width="30" height="30" style="display:block;object-fit:contain" />
                <span style="font-size:16px;font-weight:700;color:var(--brand-deep);letter-spacing:-0.2px">PrimSystem</span>
            </div>

            <div style="width:1px;height:24px;background:var(--border)"></div>

            <nav style="display:flex;align-items:center;gap:2px;height:100%">
                @foreach (var item in visibleItems)
                {
                    var active = IsActive(item.Route);
                    <button type="button" @onclick="() => Navigate(item.Route)"
                            style="padding:7px 13px;border-radius:9px;font-size:12px;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:5px;border:1px solid transparent;background:@(active ? "var(--brand-deep)" : "transparent");color:@(active ? "#fff" : "var(--text-muted)");box-shadow:@(active ? "0 3px 10px rgba(5,89,85,0.28)" : "none");transition:all 0.15s">
                        <Icon Name="@item.Icon" Size="16" />
                        @item.Label
                    </button>
                }

                @if (Session.CanManage)
                {
                    var mActive = manageRoutes.Any(r => IsActive(r));
                    <div style="position:relative;height:100%;display:flex;align-items:center">
                        <button type="button" @onclick="ToggleManageMenu"
                                style="padding:7px 13px;border-radius:9px;font-size:12px;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:5px;border:1px solid transparent;background:@(mActive ? "var(--brand-deep)" : "transparent");color:@(mActive ? "#fff" : "var(--text-muted)");box-shadow:@(mActive ? "0 3px 10px rgba(5,89,85,0.28)" : "none");transition:all 0.15s">
                            <Icon Name="gear" Size="16" />
                            Yönetim
                            <span style="font-size:9px;margin-left:2px">@(showManageMenu ? "▲" : "▼")</span>
                        </button>

                        @if (showManageMenu)
                        {
                            <div style="position:fixed;inset:0;z-index:199" @onclick="CloseManageMenu"></div>
                            <div style="position:absolute;left:0;top:100%;margin-top:4px;background:var(--bg-card);border:1px solid var(--border);border-radius:10px;box-shadow:0 8px 32px rgba(0,0,0,0.5);z-index:200;min-width:180px;overflow:hidden;padding:4px">
                                @foreach (var mi in manageItems)
                                {
                                    var mia = IsActive(mi.Route);
                                    <button type="button" @onclick="() => Navigate(mi.Route)"
                                            style="width:100%;display:flex;align-items:center;gap:8px;padding:8px 12px;border-radius:7px;cursor:pointer;text-align:left;border:none;background:@(mia ? "rgba(10,107,102,0.10)" : "transparent");color:@(mia ? "var(--brand-deep)" : "var(--text-muted)");font-size:12px;font-weight:@(mia ? "700" : "500");transition:background 0.15s">
                                        <span style="width:20px;display:flex;justify-content:center"><Icon Name="@mi.Icon" Size="16" /></span>
                                        @mi.Label
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            </nav>
        </div>

        <!-- Sag: Bildirim + Kullanici + Cikis -->
        <div style="display:flex;align-items:center;gap:8px">
            <NotificationBell />
            <div style="font-size:11px;color:var(--text-muted);max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                @Session.RoleName — @(Session.CurrentUser?.FullName ?? "")
            </div>
            <button @onclick='() => Nav.NavigateTo("/change-password")'
                    style="padding:6px 12px;background:var(--bg-card);color:var(--brand-deep);border:1px solid var(--border-strong);border-radius:9px;font-size:12px;font-weight:600;cursor:pointer">
                Şifre
            </button>
            <button @onclick="DoLogout"
                    style="padding:6px 14px;background:var(--brand-deep);color:#fff;border:1px solid var(--brand-deep);border-radius:9px;font-size:12px;box-shadow:0 3px 10px rgba(5,89,85,0.25);font-weight:600;cursor:pointer">
                Çıkış
            </button>
        </div>
    </div>
}

@code {
    private bool showManageMenu = false;
    private string currentPath = "/";

    private record NavItem(string Icon, string Label, string Route);

    private readonly NavItem[] mainItems = new[]
    {
        new NavItem("home", "Ana Sayfa", "/"),
        new NavItem("bars", "Raporlar", "/reports"),
        new NavItem("pharmacy", "Eczane Analizi", "/eczaneler"),
        new NavItem("bell", "Bildirimler", "/notifications"),
    };

    private readonly NavItem orgItem = new("users", "Organizasyon", "/organization");
    private readonly NavItem photoReviewItem = new("camera", "Foto Kontrol", "/photo-review");
    private readonly NavItem photoUploadItem = new("camera", "Fotoğraf Yükle", "/photos");
    private readonly NavItem bolgeAnalizItem = new("pin", "Bölge Analizi", "/bolgem");
    private readonly NavItem turkiyeAnalizItem = new("globe", "Overview", "/overview");
    private readonly NavItem tasksItem = new("clipboard", "Görevler", "/gorevler");

    private readonly NavItem[] manageItems = new[]
    {
        new NavItem("calc", "Hesaplama", "/calculate"),
        new NavItem("bars", "Etkinlik Analizi", "/activity"),
        new NavItem("download", "Veri Yükle", "/import"),
        new NavItem("calendar", "Dönemler", "/periods"),
        new NavItem("scale", "Scorecard", "/scorecard"),
        new NavItem("coin", "Prim Ayarları", "/prim-config"),
        new NavItem("pin", "Brick", "/bricks"),
        new NavItem("camera", "Foto Kontrol", "/photo-review"),
        new NavItem("monitor", "Kontrol Paneli", "/panel"),
    };

    private static readonly string[] manageRoutes = new[]
    {
        "/calculate", "/activity", "/import", "/periods", "/scorecard", "/prim-config", "/bricks", "/photo-review", "/panel"
    };

    private IEnumerable<NavItem> visibleItems
    {
        get
        {
            foreach (var item in mainItems)
                yield return item;
            // Bölge analiz sayfası BM'ye özel (infografik + ST/sipariş/eczane analizi).
            if (Session.IsBM)
                yield return bolgeAnalizItem;
            // Görevler: BM atar/takip eder, ST görür/günceller.
            if (Session.IsBM || Session.IsST)
                yield return tasksItem;
            // Türkiye Analizi (Kanal Müdürü) — tepeden Türkiye→Bölge→ST→ürün drill-down.
            if (Session.CanViewAll)
                yield return turkiyeAnalizItem;
            if (Session.CanViewAll)
                yield return orgItem;
            // ST: kendi saha fotoğraflarını ayrı sayfadan yükler.
            if (Session.IsST)
                yield return photoUploadItem;
            // BM: Yönetim menüsü yok; foto kontrolü ana menüden erişir.
            if (Session.IsBM)
                yield return photoReviewItem;
        }
    }

    protected override void OnInitialized()
    {
        UpdatePath();
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? _, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdatePath();
        showManageMenu = false;
        StateHasChanged();
    }

    private void UpdatePath()
    {
        currentPath = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
        if (string.IsNullOrEmpty(currentPath)) currentPath = "/";
    }

    private bool IsActive(string route)
    {
        if (route == "/") return currentPath == "/";
        return currentPath == route || currentPath.StartsWith(route + "/");
    }

    private void Navigate(string route)
    {
        showManageMenu = false;
        Nav.NavigateTo(route);
    }

    private void ToggleManageMenu() => showManageMenu = !showManageMenu;
    private void CloseManageMenu() => showManageMenu = false;

    private async Task DoLogout()
    {
        await Session.LogoutAsync(SessionStorage);
        await Session.ClearSessionAsync(SessionStorage);
        Nav.NavigateTo("/login", forceLoad: true);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
