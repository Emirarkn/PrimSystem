@using PrimSystem.Services
@inject SessionState Session

@* Yönetim rolüne, seçili çeyreğin hesaplaması brick atamalarına göre bayatsa veya
   yayınlanmamışsa net "Yeniden Hesapla / Yayınla gerekli" uyarısı gösterir.
   Brick ataması (UserBricks) yalnız yeniden hesaplamayla Calculation'a yansır ve
   yayınlanmadıkça ST/prim ekranlarında görünmez. *@
@if (Session.CanManage && Freshness != null && (Freshness.AssignmentsStale || !Freshness.Published))
{
    <AlertBanner>
        <ChildContent>
            @if (Freshness.AssignmentsStale)
            {
                <div style="display:flex;gap:8px;align-items:flex-start"><span style="color:#b9770e;flex:none;margin-top:3px"><Icon Name="warning" Size="18" /></span>
                    <span><strong>Brick atamaları veya ürün ağırlıkları son hesaplamadan sonra değişti.</strong> @Quarter @Year raporuna/prim ekranına yansıması için bu çeyreği <strong>yeniden hesaplayın</strong>.</span></div>
            }
            @if (!Freshness.Published)
            {
                <div style="display:flex;gap:8px;align-items:flex-start"><span style="color:#b9770e;flex:none;margin-top:3px"><Icon Name="pause" Size="16" /></span>
                    <span><strong>@Quarter @Year yayınlanmamış.</strong> ST ve prim ekranlarında görünmesi için <code style="padding:1px 6px;border-radius:6px;background:rgba(255,255,255,.7);font-size:12px">/calculate</code> → <strong>Yayınla</strong> adımını uygulayın.</span></div>
            }
        </ChildContent>
        <Actions>
            @if (Freshness.AssignmentsStale && OnRecalculate.HasDelegate)
            {
                <button type="button" class="p-btn p-btn--amber" @onclick="OnRecalculate"><Icon Name="refresh" Size="15" />Yeniden Hesapla</button>
            }
            <a href="/calculate" class="p-btn">Hesapla/Yayınla →</a>
        </Actions>
    </AlertBanner>
}

@code {
    [Parameter] public int Year { get; set; }
    [Parameter] public string Quarter { get; set; } = "";
    [Parameter] public CalcFreshness? Freshness { get; set; }
    [Parameter] public EventCallback OnRecalculate { get; set; }
}
