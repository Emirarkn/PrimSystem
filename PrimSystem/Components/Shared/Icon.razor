@* Tutarlı çizgi ikon seti (currentColor). Emoji yerine kullanılır: platforma göre farklı çizilmez, renk alır. *@
<svg width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "star":
            <path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.8 6.8 19.6l1-5.8-4.3-4.1 5.9-.9L12 3.5z" fill="currentColor" fill-opacity=".18"/>
            break;
        case "trophy":
            <path d="M8 4h8v5a4 4 0 0 1-8 0V4z"/><path d="M8 6H5v1.5A3 3 0 0 0 8 10.5M16 6h3v1.5a3 3 0 0 1-3 3"/><path d="M12 13v4M9 20h6M10 17h4"/>
            break;
        case "users":
            <circle cx="9" cy="9" r="3"/><circle cx="17" cy="10" r="2.4"/><path d="M3 19c0-3.2 2.7-5 6-5s6 1.8 6 5M15.5 14.2c3 .1 5.5 1.5 5.5 4.3"/>
            break;
        case "box":
            <path d="M3.5 7.5L12 3l8.5 4.5v9L12 21l-8.5-4.5v-9z"/><path d="M3.5 7.5L12 12l8.5-4.5M12 12v9"/>
            break;
        case "check":
            <rect x="3.5" y="3.5" width="17" height="17" rx="4" fill="currentColor" fill-opacity=".14"/><path d="M8 12.2l2.8 2.8L16.2 9.5"/>
            break;
        case "x":
            <path d="M6 6l12 12M18 6L6 18" stroke-width="2.6"/>
            break;
        case "bars":
            <path d="M5 20V11M12 20V5M19 20v-7" stroke-width="2.6"/>
            break;
        case "medal":
            <circle cx="12" cy="14" r="5"/><path d="M8.5 3.5L12 9l3.5-5.5M12 11.5v5"/>
            break;
        case "building":
            <path d="M5 21V8l7-4 7 4v13M3 21h18"/><path d="M9 21v-5h6v5M9 11h.01M12 11h.01M15 11h.01"/>
            break;
        case "play":
            <path d="M8 5.5v13l10-6.5-10-6.5z" fill="currentColor"/>
            break;
        case "gear":
            <circle cx="12" cy="12" r="3"/><path d="M12 3v2.5M12 18.5V21M3 12h2.5M18.5 12H21M5.6 5.6l1.8 1.8M16.6 16.6l1.8 1.8M18.4 5.6l-1.8 1.8M7.4 16.6l-1.8 1.8"/>
            break;
        case "hourglass":
            <path d="M7 3.5h10M7 20.5h10M8 3.5c0 4 4 5 4 8.5s-4 4.5-4 8.5M16 3.5c0 4-4 5-4 8.5s4 4.5 4 8.5"/>
            break;
        case "warning":
            <path d="M12 4l9 15.5H3L12 4z" fill="currentColor" fill-opacity=".16"/><path d="M12 10v4.5M12 17.2h.01"/>
            break;
        case "pause":
            <path d="M9 5.5v13M15 5.5v13" stroke-width="3"/>
            break;
        case "pill":
            <rect x="3.5" y="8" width="17" height="8" rx="4" transform="rotate(-35 12 12)"/><path d="M9 7.5l6 9"/>
            break;
        case "refresh":
            <path d="M20 11a8 8 0 0 0-14.4-4.2M4 4v4h4M4 13a8 8 0 0 0 14.4 4.2M20 20v-4h-4"/>
            break;
        case "home":
            <path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1v-9z"/>
            break;
        case "pharmacy":
            <path d="M4 20V9l8-5 8 5v11M9 20v-6h6v6M12 8v4M10 10h4"/>
            break;
        case "bell":
            <path d="M6 16v-5a6 6 0 1 1 12 0v5l1.5 2h-15L6 16zM10 21h4"/>
            break;
        case "globe":
            <circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/>
            break;
        case "calc":
            <rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8 7h8M8 12h.01M12 12h.01M16 12h.01M8 16h.01M12 16h.01M16 16h.01"/>
            break;
        case "download":
            <path d="M12 4v11M7.5 10.5L12 15l4.5-4.5M5 20h14"/>
            break;
        case "calendar":
            <rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 10h16M9 3v4M15 3v4"/>
            break;
        case "scale":
            <path d="M12 4v16M6 20h12M5 7h14M5 7l-2.5 6a3 3 0 0 0 5 0L5 7zM19 7l-2.5 6a3 3 0 0 0 5 0L19 7z"/>
            break;
        case "coin":
            <circle cx="12" cy="12" r="8.5"/><path d="M14.5 9.2c-.5-.8-1.4-1.2-2.5-1.2-1.4 0-2.4.7-2.4 1.8 0 2.6 5 1.2 5 4 0 1.1-1.1 1.9-2.6 1.9-1.1 0-2.1-.5-2.6-1.4M12 6.5V8M12 16v1.5"/>
            break;
        case "pin":
            <path d="M12 21s7-6 7-11a7 7 0 1 0-14 0c0 5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/>
            break;
        case "camera":
            <path d="M4 8h3l1.5-2.5h7L17 8h3v11H4V8z"/><circle cx="12" cy="13" r="3.5"/>
            break;
        case "monitor":
            <rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>
            break;
        case "clipboard":
            <rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4h6v3H9zM8.5 12h7M8.5 16h5"/>
            break;
        case "edit":
            <path d="M4 20h4L19 9l-4-4L4 16v4zM13.5 6.5l4 4"/>
            break;
        case "key":
            <circle cx="8" cy="15" r="4"/><path d="M11 12l9-9M16 7l3 3M14 9l2 2"/>
            break;
        case "user":
            <circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/>
            break;
        case "trash":
            <path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/>
            break;
        case "search":
            <circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/>
            break;
        case "plus":
            <path d="M12 5v14M5 12h14" stroke-width="2.4"/>
            break;
        default:
            <circle cx="12" cy="12" r="8"/>
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 18;
}
