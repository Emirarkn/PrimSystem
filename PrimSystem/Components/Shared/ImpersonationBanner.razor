@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using PrimSystem.Services
@inject SessionState Session
@inject ProtectedSessionStorage SessionStorage
@inject NavigationManager Nav
@implements IDisposable

@if (Session.IsImpersonating)
{
    <div style="position:fixed;top:0;left:0;right:0;z-index:9999;background:#f59e0b;padding:8px 20px;display:flex;align-items:center;justify-content:space-between;font-family:Segoe UI,sans-serif;font-size:13px;font-weight:600;color:#0a0f1a;box-shadow:0 2px 8px rgba(0,0,0,0.4)">
        <span>👤 Admin görünümü: <strong>@Session.CurrentUser?.FullName</strong> (@Session.CurrentUser?.Role?.Name) olarak görüntülüyorsunuz</span>
        <button @onclick="StopImpersonating"
                style="padding:5px 16px;background:#0a0f1a;color:#f59e0b;border:none;border-radius:6px;font-size:12px;font-weight:700;cursor:pointer;flex-shrink:0">
            ← Kendi Hesabıma Dön
        </button>
    </div>
    <div style="height:38px"></div>
}

@code {
    protected override void OnInitialized()
    {
        Session.OnChange += HandleChange;
    }

    private void HandleChange() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.OnChange -= HandleChange;

    private async Task StopImpersonating()
    {
        await Session.StopImpersonatingAsync(SessionStorage);
        Nav.NavigateTo("/organization");
    }
}
