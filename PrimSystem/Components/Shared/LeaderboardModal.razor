@using PrimSystem.Services
@using PrimSystem.Data
@using System.Globalization
@inject CalculationService CalcSvc

@if (Show)
{
    <!-- Arka plan: bulanık krem -->
    <div style="position:fixed;inset:0;z-index:1000;background:rgba(250,246,239,0.62);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;padding:16px"
         @onclick="OnClose">
        <div role="dialog" aria-modal="true" aria-labelledby="lbTitle"
             style="background:linear-gradient(180deg,#fffcf6,#fbf5ea);border:1px solid #d9cdb5;border-radius:24px;width:min(700px,100%);max-height:88vh;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 28px 70px rgba(5,89,85,0.22)"
             @onclick:stopPropagation>

            <!-- Başlık -->
            <div style="padding:20px 26px 14px;display:flex;align-items:center;justify-content:space-between;gap:12px">
                <div style="display:flex;align-items:center;gap:16px;min-width:0">
                    <div style="display:flex;align-items:center;gap:9px;flex:none">
                        <img src="/images/prim-symbol.png" alt="" width="34" height="34" style="display:block;object-fit:contain" />
                        <span style="font-size:18px;font-weight:800;color:var(--brand-deep)">PrimSystem</span>
                    </div>
                    <div style="width:1px;align-self:stretch;background:#d9cdb5;flex:none"></div>
                    <div style="min-width:0">
                        <h2 id="lbTitle" style="margin:0;font-size:24px;font-weight:800;color:var(--brand-deep);letter-spacing:-.3px">Sipariş Sıralaması</h2>
                        <div style="font-size:14px;color:var(--text-muted);margin-top:2px">@Quarter @Year · @(string.IsNullOrEmpty(ProductName) ? "Tüm Ürünler" : ProductName)</div>
                    </div>
                </div>
                <button type="button" @onclick="OnClose" aria-label="Kapat"
                        style="flex:none;display:flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:12px;border:1px solid transparent;background:transparent;color:var(--text);cursor:pointer">
                    <Icon Name="x" Size="22" />
                </button>
            </div>
            <div style="height:1px;margin:0 26px;background:linear-gradient(90deg,#d9a04a,#2fa398 40%,#cfc6b5)"></div>

            <!-- İçerik -->
            <div style="overflow-y:auto;flex:1;padding:6px 26px 20px">
                @if (isLoading)
                {
                    <LoadingBlock Padding="30" />
                }
                else if (!allRows.Any())
                {
                    <div style="padding:40px;text-align:center;color:var(--text-muted);font-size:14px">Sipariş verisi bulunamadı</div>
                }
                else
                {
                    <!-- Kolon başlıkları -->
                    <div style="display:grid;grid-template-columns:52px 1fr 92px 92px 74px;gap:8px;padding:12px 8px 8px;font-size:13px;font-weight:700;color:var(--text);border-bottom:1px solid #cfc6b5">
                        <div>#</div>
                        <div>Satış Temsilcisi</div>
                        <div style="text-align:right">Kutu</div>
                        <div style="text-align:right">TL</div>
                        <div style="text-align:right">Kurum</div>
                    </div>

                    @foreach (var r in top10)
                    {
                        var isSelf = r.UserId == CurrentUserId;
                        var barColor = r.Rank == 1 ? "#e0a22b" : r.Rank <= 3 ? "#1f8a7c" : "transparent";
                        <div style="display:grid;grid-template-columns:52px 1fr 92px 92px 74px;gap:8px;align-items:center;padding:10px 8px;border-bottom:1px solid #e7dfce;background:@(r.Rank == 1 ? "linear-gradient(90deg,#fdeed2,#fff6e4)" : isSelf ? "rgba(10,107,102,0.08)" : "transparent")">
                            <div style="display:flex;align-items:center;gap:8px;font-size:17px;font-weight:800;color:var(--text)">
                                <span style="width:4px;height:26px;border-radius:2px;background:@barColor"></span>@r.Rank.ToString("00")
                            </div>
                            <div style="min-width:0">
                                <div style="font-size:15px;font-weight:800;color:var(--text);text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                                    @r.FullName
                                    @if (isSelf)
                                    {
                                        <span style="font-size:11px;font-weight:700;color:var(--brand);margin-left:6px;text-transform:none">(sen)</span>
                                    }
                                </div>
                                <div style="font-size:13px;color:var(--text-muted)">@r.Region</div>
                            </div>
                            <div style="text-align:right;font-size:19px;font-weight:800;color:var(--brand);font-variant-numeric:tabular-nums">@r.TotalBoxes.ToString("N0", Tr)</div>
                            <div style="text-align:right;font-size:14px;color:var(--text);font-variant-numeric:tabular-nums">@r.TotalTL.ToString("N0", Tr)</div>
                            <div style="text-align:right;font-size:14px;color:var(--text);font-variant-numeric:tabular-nums">@r.UniquePharmacies.ToString("N0", Tr)</div>
                        </div>
                    }

                    <!-- Kullanıcının sırası (ilk 10 dışındaysa) -->
                    @if (myRank > 10)
                    {
                        var myRow = allRows.FirstOrDefault(x => x.UserId == CurrentUserId);
                        @if (myRow != null)
                        {
                            <div style="display:grid;grid-template-columns:52px 1fr 92px 92px 74px;gap:8px;align-items:center;margin-top:10px;padding:10px 8px;background:rgba(10,107,102,0.08);border:1px solid rgba(10,107,102,0.3);border-radius:12px">
                                <div style="font-size:17px;font-weight:800;color:var(--brand)">@myRank.ToString("00")</div>
                                <div style="font-size:15px;font-weight:800;color:var(--text);text-transform:uppercase">@myRow.FullName <span style="font-size:11px;text-transform:none;color:var(--brand)">(sen)</span></div>
                                <div style="text-align:right;font-size:19px;font-weight:800;color:var(--brand)">@myRow.TotalBoxes.ToString("N0", Tr)</div>
                                <div style="text-align:right;font-size:14px">@myRow.TotalTL.ToString("N0", Tr)</div>
                                <div style="text-align:right;font-size:14px">@myRow.UniquePharmacies.ToString("N0", Tr)</div>
                            </div>
                        }
                    }

                    <!-- Alt bilgi -->
                    <div style="padding-top:14px;text-align:center">
                        @if (myRank > 0)
                        {
                            <span style="font-size:13px;color:var(--text-muted)">Senin sıran: <strong style="color:var(--text)">@myRank</strong> / @allRows.Count ST</span>
                        }
                        else
                        {
                            <span style="font-size:13px;color:var(--text-muted)">Toplam @allRows.Count ST</span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private static readonly CultureInfo Tr = new("tr-TR");

    [Parameter] public bool Show { get; set; }
    [Parameter] public int Year { get; set; }
    [Parameter] public string Quarter { get; set; } = "";
    [Parameter] public int CurrentUserId { get; set; }
    [Parameter] public int? ProductId { get; set; }
    [Parameter] public string? ProductName { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private bool isLoading = false;
    private List<OrderLeaderRow> allRows = new();
    private List<OrderLeaderRow> top10 = new();
    private int myRank = 0;
    private int _loadedYear = 0;
    private string _loadedQuarter = "";
    private int? _loadedProductId;

    protected override async Task OnParametersSetAsync()
    {
        if (Show && Year > 0 && !string.IsNullOrEmpty(Quarter)
            && (Year != _loadedYear || Quarter != _loadedQuarter || ProductId != _loadedProductId))
            await LoadData();
    }

    private async Task LoadData()
    {
        _loadedYear = Year;
        _loadedQuarter = Quarter;
        _loadedProductId = ProductId;
        isLoading = true;
        try
        {
            allRows = await CalcSvc.GetOrderLeaderboardAsync(ProductId, Year, Quarter);
            top10 = allRows.Take(10).ToList();
            myRank = allRows.FirstOrDefault(r => r.UserId == CurrentUserId)?.Rank ?? 0;
        }
        finally { isLoading = false; }
    }
}
