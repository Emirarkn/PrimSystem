@* Öne çıkan kişi kartı (Haftanın / Ayın Yıldızı). Dark = koyu yeşil zemin, aksi halde krem. *@
<div class="p-spot @(Dark ? "p-spot--dark" : "")">
    <div class="p-spot__head">
        <div class="p-spot__label"><Icon Name="@IconName" Size="17" />@Title</div>
        <div style="display:flex;gap:6px">@Actions</div>
    </div>
    @if (!string.IsNullOrEmpty(Name))
    {
        <div class="p-spot__name">@Name</div>
        <div class="p-spot__meta">@Meta</div>
        <div class="p-spot__value"><Icon Name="@ValueIcon" Size="20" />@Value</div>
    }
    else
    {
        <div class="p-spot__empty">@EmptyText</div>
    }
    <svg class="p-spot__deco" viewBox="0 0 120 120" aria-hidden="true">
        @if (Decor == "cross")
        {
            <ellipse cx="62" cy="108" rx="48" ry="9" fill="#e4b64a" opacity=".85"/>
            <ellipse cx="62" cy="103" rx="40" ry="8" fill="#f6d77e"/>
            <path d="M46 46h20V32h14v14h14v20H80v14H66V66H46V46z" fill="#69cdb9" opacity=".95"/>
            <path d="M18 70c-8-14-4-30 4-38M104 70c8-14 4-30-4-38" stroke="#e4b64a" stroke-width="3" fill="none" stroke-linecap="round" opacity=".9"/>
        }
        else
        {
            <ellipse cx="62" cy="108" rx="46" ry="8" fill="#e4b64a" opacity=".8"/>
            <rect x="26" y="52" width="72" height="50" rx="4" fill="#fff6e6" stroke="#d7a24a" stroke-width="2"/>
            <path d="M22 54l40-26 40 26z" fill="#2fa398" stroke="#0a6b66" stroke-width="2"/>
            <rect x="52" y="76" width="20" height="26" rx="2" fill="#0a6b66"/>
            <path d="M56 40h12M62 34v12" stroke="#fff" stroke-width="3" stroke-linecap="round"/>
        }
    </svg>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string IconName { get; set; } = "star";
    [Parameter] public bool Dark { get; set; }
    [Parameter] public string? Name { get; set; }
    [Parameter] public string Meta { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string ValueIcon { get; set; } = "box";
    [Parameter] public string EmptyText { get; set; } = "Veri bulunamadı";
    [Parameter] public string Decor { get; set; } = "cross";
    [Parameter] public RenderFragment? Actions { get; set; }
}
