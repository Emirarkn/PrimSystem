@*
  Tekrarlanan badge/pill pattern'ini tek noktaya alır.
  Kullanım:
    <StatusBadge Variant="success" Label="Yayında" Icon="🟢" />
    <StatusBadge Variant="warning" Label="@($"Sıralama Yayında")" />
    <StatusBadge Variant="danger"  Label="Geçemedi" />
    <StatusBadge Variant="info"    Label="2026 Q1" />
    <StatusBadge Variant="muted"   Label="Beklemede" Size="sm" />
*@

<span style="@ComputedStyle">
    @if (!string.IsNullOrEmpty(Icon))
    {
        <span style="margin-right:4px">@Icon</span>
    }
    @Label
</span>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Icon { get; set; } = "";
    /// <summary>success | warning | danger | info | purple | cyan | muted</summary>
    [Parameter] public string Variant { get; set; } = "muted";
    /// <summary>sm | md (default)</summary>
    [Parameter] public string Size { get; set; } = "md";

    private string ComputedStyle
    {
        get
        {
            var (bg, color, border) = Variant switch
            {
                "success" => ("rgba(16,185,129,0.12)", "#10b981", "rgba(16,185,129,0.3)"),
                "warning" => ("rgba(245,158,11,0.12)", "#f59e0b", "rgba(245,158,11,0.3)"),
                "danger"  => ("rgba(239,68,68,0.12)",  "#ef4444", "rgba(239,68,68,0.3)"),
                "info"    => ("rgba(59,130,246,0.12)", "#3b82f6", "rgba(59,130,246,0.3)"),
                "purple"  => ("rgba(99,102,241,0.12)", "#6366f1", "rgba(99,102,241,0.3)"),
                "cyan"    => ("rgba(6,182,212,0.12)",  "#06b6d4", "rgba(6,182,212,0.3)"),
                _         => ("rgba(148,163,184,0.1)", "#94a3b8", "rgba(148,163,184,0.25)")
            };

            var padding = Size == "sm" ? "2px 8px" : "4px 10px";
            var fontSize = Size == "sm" ? "10px" : "11px";

            return $"display:inline-flex;align-items:center;padding:{padding};border-radius:6px;font-size:{fontSize};font-weight:700;background:{bg};color:{color};border:1px solid {border};white-space:nowrap";
        }
    }
}
